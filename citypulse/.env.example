# ==============================================================================
# CityPulse: TrafficPulse AI — Environment Configuration Template
# ==============================================================================
# Copy this file to '.env' for local development overrides.
# NEVER commit sensitive API keys or credentials to version control.
# ==============================================================================

# Directory Paths
CITYPULSE_DATA_DIR=data

# Streamlit Server Configuration
STREAMLIT_SERVER_PORT=8501
STREAMLIT_SERVER_HEADLESS=true
STREAMLIT_BROWSER_GATHER_USAGE_STATS=false

# Optional: Mapbox Token (Optional: falls back to open-street-map tiles if not supplied)
# MAPBOX_API_TOKEN=your_mapbox_token_here
